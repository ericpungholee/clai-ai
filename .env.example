# Copy to `.env` and fill in required values. Do not commit `.env`.

POSTGRES_USER=clai
POSTGRES_PASSWORD=
POSTGRES_DB=clai
DATABASE_URL=

REDIS_URL=redis://redis:6379/0

FAL_KEY=
FAL_TIMEOUT_SECONDS=120

ARTIFACT_STORAGE_BACKEND=filesystem
ARTIFACT_STORAGE_PATH=.data/artifacts
ARTIFACT_PUBLIC_BASE_URL=http://localhost:8000/artifacts
# Required only when ARTIFACT_STORAGE_BACKEND=s3.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
