# Copy to `.env`. Add your own fal API key to use generation features.
# Never commit `.env` or real credentials.

POSTGRES_USER=clai
POSTGRES_PASSWORD=clai-local
POSTGRES_DB=clai

REDIS_URL=redis://redis:6379/0

FAL_KEY=
FAL_TIMEOUT_SECONDS=120
FAL_OUTPUT_HOSTS=v3.fal.media,v3b.fal.media

ARTIFACT_STORAGE_BACKEND=filesystem
ARTIFACT_STORAGE_PATH=.data/artifacts
ARTIFACT_PUBLIC_BASE_URL=http://localhost:8000/artifacts
# Required only when ARTIFACT_STORAGE_BACKEND=s3.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
